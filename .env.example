# Frontend (optional)
VITE_BOOKING_API_URL=/api/send-booking

# Node booking API (optional)
BOOKING_API_PORT=3001

# SMTP config
EMAIL_HOST=mail.example.com
EMAIL_PORT=587
EMAIL_USER=mailer@example.com
EMAIL_PASSWORD=your_password
EMAIL_ENCRYPTION=tls
FROM_EMAIL=mailer@example.com
FROM_NAME=Metro Mobile Mechanics
BOOKING_TO_EMAIL=bookings@metromobilemechanics.co.za
BOOKING_TO_NAME=Metro Mobile Mechanics - Bookings

# Secure quote link settings (used in admin booking emails)
# IMPORTANT: set a strong random value for QUOTE_LINK_SECRET in production.
QUOTE_LINK_SECRET=change_this_to_a_long_random_secret
QUOTE_LINK_BASE_URL=https://metromobilemechanics.co.za
QUOTE_LINK_TTL_MINUTES=1440
APP_DEBUG=0
